name: magni-description-snap-re
base: core24
version: '1.1'
summary: Magni Description Snap
description: |
  This Snap packages the Magni robot description and launch files.

grade: devel
confinement: strict

parts:
  ros-packages:
    plugin: nil
    build-packages:
      - ca-certificates
      - apt-transport-https
      - gnupg
      - curl
    override-build: |
      # Add ROS 2 apt repository
      echo "deb [arch=amd64,arm64] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" > /etc/apt/sources.list.d/ros2.list
      curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.key | apt-key add -
      apt-get update

      # Install necessary tools
      apt-get -y install python3-rosdep
      rosdep init || true
      rosdep update
      
      # No build needed for this part
      snapcraftctl build

  magni-description:
    after: [ros-packages]
    plugin: colcon
    source: ../  # if snap/ is inside magni_description/
    source-type: local
    build-environment:
      - ROS_DISTRO: jazzy
    build-packages:
      - build-essential
      - cmake
      - python3-colcon-common-extensions
      - python3-pip
      - python3-vcstool
      #- python3-rosdep
    stage-packages:
      - ros-jazzy-controller-manager
      - ros-jazzy-diff-drive-controller
      - ros-jazzy-ros2launch
      - ros-jazzy-teleop-twist-keyboard
      - ros-jazzy-xacro
      - ros-jazzy-joint-state-publisher
      - ros-jazzy-joint-state-publisher-gui
      - ros-jazzy-robot-state-publisher
      - ros-jazzy-rviz2
      - ros-jazzy-gazebo-ros
      - ros-jazzy-ros-gz-bridge
      - ros-jazzy-robot-localization
      - ros-jazzy-navigation2
      - ros-jazzy-nav2-bringup
      - ros-jazzy-nav2-simple-commander
      - ros-jazzy-slam-toolbox

apps:
  description-launch:
    command: opt/ros/jazzy/bin/ros2 launch magni_description description.launch.py
    plugs: [network, network-bind, hardware-observe, joystick, home]
    environment:
      ROS_DOMAIN_ID: '0'
      LD_LIBRARY_PATH: $SNAP/opt/ros/jazzy/lib:${LD_LIBRARY_PATH}
      ROS_HOME: $SNAP_USER_COMMON/.ros